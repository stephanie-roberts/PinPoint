{
  "name": "@tc-pinpoint/core",
  "version": "0.7.2",
  "private": true,
  "description": "Shared types and schema definitions for @tcpinpoint packages",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "default": "./src/testing.ts"
    }
  },
  "author": "Stephanie Lennox",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tcpinpoint",
    "types",
    "schema",
    "feedback"
  ],
  "license": "MIT"
}
