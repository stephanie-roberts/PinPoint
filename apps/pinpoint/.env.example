# Copy this file to .env and fill it in.

# Sign-in codes are emailed through Postmark (https://postmarkapp.com).
# Use a Server API token, and a From address on a domain verified in Postmark.
# Leave the token empty while you try it out: codes are printed in the Terminal instead.
POSTMARK_SERVER_TOKEN=
TC_PINPOINT_EMAIL_FROM=pinpoint@thoughtcollective.com

# Anyone with an email at these domains is on your team: they can use the inbox,
# change statuses, delete snags and snag every site. Separate several with commas.
TC_PINPOINT_TEAM_DOMAINS=thoughtcollective.com

# Where snags are saved, and the port to run on.
TC_PINPOINT_DATA=data/snags.json
PORT=3000

# Set to true when hosted behind a proxy (Railway, Render, Fly.io…).
TC_PINPOINT_TRUST_PROXY=false
