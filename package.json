{
  "name": "pinpoint",
  "private": true,
  "description": "PinPoint: a self-hosted snagging tool. Clients pin feedback to their website; your team works through it in one inbox.",
  "type": "module",
  "author": "Stephanie Lennox",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/pinpoint",
    "start": "npm run start -w apps/pinpoint",
    "build": "turbo run build",
    "check": "turbo run check //#check:root",
    "check:root": "tsc --noEmit",
    "clean": "turbo run clean",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "verify": "npm run build && npm run check && npm run lint && npm run test:run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "fast-check": "^4.10.2",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.27"
  }
}
